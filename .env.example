# ai-stack environment variables.
#
# Copy this file to `.env` before starting Compose:
#
#     cp .env.example .env
#
# Never commit the real `.env`. Only the variables consumed by the active
# stack are active below; the rest are documented placeholders for planned
# features and must not be treated as required.

# --- Consumed by compose.yaml -------------------------------------------------
# Required. PostgreSQL password for the `db` service. Compose also uses it to
# build DATABASE_URL for py-server. Use a strong, unique value.
POSTGRES_PASSWORD=change-me-postgres-password

# --- Client-facing endpoint ---------------------------------------------------
# Host bind and port for the published py-server port (defaults 0.0.0.0:8400).
#PY_SERVER_BIND=0.0.0.0
#PY_SERVER_PORT=8400
# Comma-separated browser origins allowed to open the WebSocket. Empty means
# "same host as the request".
#ALLOWED_ORIGINS=
# Serialize this many GPU turns at once (single-user default is 1).
#MAX_GPU_CONCURRENCY=1

# --- Optional client-facing TLS ----------------------------------------------
# Set BOTH and mount certificate material read-only; otherwise serve HTTP.
#SSL_CERTFILE=/certs/server.crt
#SSL_KEYFILE=/certs/server.key
# Opt-in development auto-reload (never enable in normal use).
#UVICORN_RELOAD=0

# --- LLM (OpenAI-compatible llama.cpp endpoint) -------------------------------
# Internal Compose service by default.
#LLM_API_URL=http://llama-server:8000/v1
#LLM_MODEL=stheno
#LLM_TIMEOUT=120
#LLM_TEMPERATURE=0.9
#LLM_TOP_P=1.0
#LLM_FREQUENCY_PENALTY=0.1
#LLM_MAX_TOKENS=400

# --- Speech-to-text -----------------------------------------------------------
#STT_MODEL=base
#STT_DEVICE=cuda
#STT_COMPUTE_TYPE=float16
#STT_LANGUAGE=en
#STT_BEAM_SIZE=5

# --- Text-to-speech -----------------------------------------------------------
# Path to the Piper voice; see py-server/voices/README.md.
#TTS_VOICE_PATH=./voices/hal.onnx

# --- Assistant behaviour ------------------------------------------------------
# One of: assistant (default), character, coding.
#PERSONA=assistant
# Overrides the selected persona's system prompt.
#SYSTEM_PROMPT=You are a helpful, concise personal assistant.

# --- Conversation storage (opt-in) --------------------------------------------
# none = stateless (default), memory = ephemeral short-term history.
# See docs/decisions/0002-storage-and-memory.md.
#STORE_BACKEND=none
#HISTORY_MAX_MESSAGES=20

# --- Not consumed by the current stack (reserved for planned work) ------------
# PostgreSQL is optional and started only with `docker compose --profile db up`.
# Reserved for the persistence milestone; not consumed yet.
#DATABASE_URL=postgres://ai:change-me-postgres-password@db:5432/ai
#TRANSCRIPT_PERSISTENCE=false
# HF_TOKEN is not read by any active service.
#HF_TOKEN=change-me-huggingface-token
# OPENAI_API_KEY is not read by any active service. The pipeline talks to a
# local OpenAI-compatible llama.cpp endpoint, not to OpenAI.
#OPENAI_API_KEY=change-me-openai-key
# INITIAL_PASSWORD is not read by any active service.
#INITIAL_PASSWORD=change-me-initial-password


#--- For Caddy -----------------------------------------------------------------
# CF_API_TOKEN=paste_token_here